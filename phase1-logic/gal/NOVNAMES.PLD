Revision 01 ;
Designer Engineer ;
Company  LAsalle ;
Assembly None ;
Location  ;
Device   G22v10;

/* *************** INPUT PINS *********************/
PIN 1     =           M16_Keys             ; /*                                 */
PIN 2    =            Q0            ; /*                                 */
PIN 3    =            Q1             ; /*                                 */
PIN 4    =            Q2             ; /*                                 */
PIN 5    =            Q3             ; /*                                 */
PIN 6    =            PCI             ; /*                                 */
PIN 8    =            C2             ; /*                                 */
PIN 9    =            C1             ; /*                                 */
PIN 10   =            C0;
PIN 11    =           T_Save           ; /*                                 */

/* *************** OUTPUT PINS *********************/
PIN 14    =         M1_Pressed                ; /*                                 */
PIN 16    =         MR_16S               ; /*                                 */
PIN 17    =         T_Led                ; /*                                 */
PIN 18    =         CLK_Reg7                ; /*                                 */
PIN 19    =         Ack                ; /*                                 */
PIN 20    =         Reset2                ; /*                                 */
PIN 21    =         Key_Pressed                ; /*                                 */

M1_Pressed = Q0 # Q1 #  Q2 # Q3 # M16_Keys;
MR_16S = !(!PCI # Reset2);
CLK_Reg7 = !T_Save # !T_Led;
Key_Pressed = !(C2 & C1 & C0);
